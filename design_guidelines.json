  "layout_and_spacing": {
    "spacing_philosophy": "Generous Notion-inspired whitespace, whisper 1px borders, subtle soft shadows, warm tactile feel.",
    "container_max_width": "max-w-6xl mx-auto px-4 sm:px-6 lg:px-8",
    "reading_max_width": "max-w-3xl mx-auto",
    "sidebar_width": "w-64 flex-shrink-0",
    "card_radius": "rounded-xl border border-border shadow-xs",
    "button_radius": "rounded-lg font-medium shadow-2xs hover:shadow-xs transition-all duration-150"
  },
  "page_layouts": {
    "Today": {
      "description": "Primary hero screen. Warm greeting based on time of day, current focus session widget, today's schedule/planner timeline, priority tasks, study streak widget, and quick action bar.",
      "grid": "grid grid-cols-1 lg:grid-cols-12 gap-6",
      "components": ["GreetingHeader", "FocusTimerWidget", "TodayPlannerTimeline", "TaskListSummary", "StreakCard", "CurriculumProgressCard"]
    },
    "Subjects": {
      "description": "Visual grid of subjects with calm color coding, completed units count, next upcoming lesson, and progress bars.",
      "grid": "grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5",
      "components": ["SubjectCard", "AddSubjectModal", "SubjectColorPicker", "CurriculumOverviewStats"]
    },
    "SubjectDetail": {
      "description": "Hierarchical view of a single subject containing units, accordion of lessons, associated notebooks, and study statistics.",
      "grid": "grid grid-cols-1 lg:grid-cols-12 gap-6",
      "components": ["SubjectBannerHeader", "UnitListAccordion", "LessonItemCard", "LinkedNotebooksSection"]
    },
    "LessonDetail": {
      "description": "Dedicated study view for a single lesson. Contains lesson status toggle, key concepts, embedded notebook editor link, exercise list, and launch focus session CTA.",
      "grid": "max-w-4xl mx-auto space-y-6",
      "components": ["LessonHeader", "LessonStatusBadge", "ConceptsList", "ExerciseChecklist", "StartStudySessionButton"]
    },
    "Notebooks": {
      "description": "Distraction-free paper-inspired writing canvas with markdown support, rich text formatting bar, autosave indicator, subject filter sidebar, and full-bleed focus toggle.",
      "grid": "flex flex-col md:flex-row gap-6 min-h-[75vh]",
      "components": ["NotebookSidebarList", "PaperCanvasEditor", "AutosaveStatusBadge", "FormatToolbar"]
    },
    "FocusTimer": {
      "description": "Client-side study timer (Pomodoro & Stopwatch modes) with subject tagging, ambient background toggle, log session modal, and peaceful distraction-free full-screen mode.",
      "grid": "max-w-2xl mx-auto text-center py-10 space-y-8",
      "components": ["TimerCircleDisplay", "ModeSelector", "SubjectSelectorDropdown", "AmbientSoundToggle", "FullscreenTimerOverlay", "SessionSummaryModal"]
    },
    "Tasks": {
      "description": "Planner board & list views for exercises, homework, and exam prep. Filterable by subject, due date, priority, and completed status.",
      "grid": "space-y-6",
      "components": ["TaskFilterTabs", "TaskGroupList", "AddTaskDialog", "PriorityBadge", "SubjectTag"]
    },
    "Analytics": {
      "description": "Study time graphs, weekly heatmaps, subject time allocation breakdown, streak history, and review progress stats.",
      "grid": "grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5",
      "components": ["StudyTimeChart", "SubjectAllocationPie", "StreakCalendarHeatmap", "StatMetricCard"]
    },
    "Settings": {
      "description": "User profile, default timer settings (Pomodoro durations), timezone selector, dark/light theme toggle, notification reminders, and seed data trigger.",
      "grid": "max-w-3xl mx-auto space-y-8",
      "components": ["ProfileSection", "TimerPreferencesForm", "ThemeSelector", "DataManagementCard"]
    },
    "Auth": {
      "description": "Clean, warm centered auth card with email/password forms and social login trigger.",
      "grid": "min-h-screen flex items-center justify-center p-4 bg-background",
      "components": ["AuthCard", "LoginForm", "RegisterForm", "OAuthButtons"]
    },
    "Onboarding": {
      "description": "Minimal 3-step setup flow: Name & Academic Goals -> Select Subjects & Color Tags -> Daily Target Hours.",
      "grid": "max-w-xl mx-auto py-12 px-4 space-y-8",
      "components": ["OnboardingStepper", "GoalSelectionStep", "SubjectSetupStep", "TargetHoursStep"]
    }
  },
  "motion_and_interaction": {
    "hover": "transition-all duration-200 ease-out hover:-translate-y-0.5",
    "button_press": "active:scale-[0.98] transition-transform duration-100",
    "page_transition": "animate-in fade-in-50 duration-300",
    "modal_animation": "animate-in zoom-in-95 fade-in-0 duration-200"
  },
  "testing_attributes": {
    "requirement": "All interactive buttons, inputs, tags, tabs, cards, and modal controls MUST include a specific data-testid attribute in kebab-case.",
    "examples": [
      "data-testid='today-focus-timer-button'",
      "data-testid='subject-card-sage'",
      "data-testid='notebook-autosave-indicator'",
      "data-testid='theme-toggle-button'",
      "data-testid='task-checkbox-12'"
    ]
  },
