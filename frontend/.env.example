# Optional browser-visible API base. Production uses same-origin /api by default.
# Never place Google, Stripe, JWT, database, or admin secrets in VITE_* variables.
VITE_API_BASE_URL=http://localhost:8000/api

# Development-server proxy target when VITE_API_BASE_URL is omitted.
VITE_API_PROXY_TARGET=http://localhost:8000
