# Copy these names into Coolify's environment panel. Never commit real values.
ENVIRONMENT=production
APP_URL=https://syllo.kavinhq.com
DATABASE_URL=mysql+asyncmy://syllo:replace-me@mysql.example.com:3306/syllo?charset=utf8mb4
JWT_SECRET=replace-with-a-long-random-jwt-secret
OAUTH_STATE_SECRET=replace-with-a-different-long-random-secret
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REDIRECT_URI=https://syllo.kavinhq.com/api/auth/google/callback
MOBILE_OAUTH_REDIRECT_URI=syllo://google-callback

STRIPE_SECRET_KEY=sk_live_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_SCHOLAR=price_replace_me
STRIPE_PRICE_DEANS_LIST=price_replace_me
# Stripe coupon: $3.00 off Dean's List, repeating for 3 months.
STRIPE_DEANS_INTRO_COUPON=coupon_replace_me

ADMIN_BOOTSTRAP_ENABLED=true
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-unique-password

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE=1800
LOG_LEVEL=INFO

# Required to enable Study Companion. All inference runs in Google's API, not here.
GEMINI_API_KEY=replace-with-google-ai-studio-key
GEMINI_FRESHMAN_MODEL=gemini-3.1-flash-lite
GEMINI_TUTOR_MODEL=gemini-3.8-flash
GEMINI_UTILITY_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=30
GEMINI_USER_REQUESTS_PER_MINUTE=10
# Hard application-side stop for estimated monthly Gemini spend; 2500 = $25.
GEMINI_MONTHLY_BUDGET_CENTS=2500

FREE_PLAN_START_CREDITS=10
FREE_PLAN_MILESTONE_MAX_CREDITS=60
FREE_PLAN_MAX_CREDITS=100
REFERRAL_BONUS_CREDITS=15
DEANS_INTRO_MONTHS=3
