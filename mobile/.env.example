# Environment for Syllo Mobile
# Copy this file to /app/mobile/.env and fill in the values.

# Backend API base. Must match the web app's REACT_APP_BACKEND_URL + "/api".
# Example: https://syllo-preview.preview.emergentagent.com/api
EXPO_PUBLIC_API_BASE=

# Emergent Google auth entry point. Leave as default unless you know why to change it.
EXPO_PUBLIC_GOOGLE_AUTH_URL=https://auth.emergentagent.com/
