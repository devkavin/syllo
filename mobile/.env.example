# Environment for Syllo Mobile
# Copy this file to mobile/.env and fill in local values.

# Backend API base. Mobile values are public and must never contain secrets.
EXPO_PUBLIC_API_BASE=http://localhost:8000/api

# Temporary until the application-owned Google OAuth migration is implemented.
# Set this explicitly for local testing; do not fall back to a shared provider.
EXPO_PUBLIC_GOOGLE_AUTH_URL=
