#!/bin/bash
set -euo pipefail

# Check the blobs entering this commit, not dependencies or unstaged edits.
limit_bytes=$((90 * 1024 * 1024))

git diff --cached --name-only -z --diff-filter=ACMRT -- | (
    failed=0
    while IFS= read -r -d '' path; do
        if ! size=$(git cat-file -s ":$path"); then
            printf 'Cannot read the staged size of %q. Commit blocked.\n' "$path" >&2
            exit 1
        fi
        if ((size > limit_bytes)); then
            printf 'Staged file %q is %s bytes; the limit is 90 MiB (%s bytes).\n' "$path" "$size" "$limit_bytes" >&2
            failed=1
        fi
    done
    if ((failed)); then
        printf 'Commit blocked. Remove oversized files from staging or use Git LFS, then retry.\n' >&2
    fi
    exit "$failed"
)
