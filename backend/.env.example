# Local development. Production values belong in Coolify.
ENVIRONMENT=development
APP_URL=http://localhost:5173
DATABASE_URL=mysql+asyncmy://syllo:change-me@127.0.0.1:3306/syllo?charset=utf8mb4
JWT_SECRET=replace-with-at-least-32-random-characters
OAUTH_STATE_SECRET=replace-with-another-32-random-characters
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
MOBILE_OAUTH_REDIRECT_URI=syllo://google-callback

BILLING_ENABLED=false

ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional locally. When set, inference runs in Google's API rather than this server.
GEMINI_API_KEY=
GEMINI_FRESHMAN_MODEL=gemini-3.1-flash-lite
GEMINI_TUTOR_MODEL=gemini-3.8-flash
GEMINI_UTILITY_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=30
GEMINI_USER_REQUESTS_PER_MINUTE=10
GEMINI_PROJECT_REQUESTS_PER_MINUTE=10
GEMINI_MONTHLY_BUDGET_CENTS=2500

FREE_PLAN_START_CREDITS=40
FREE_PLAN_MILESTONE_MAX_CREDITS=90
FREE_PLAN_MAX_CREDITS=100
REFERRAL_BONUS_CREDITS=10
DEANS_INTRO_MONTHS=3

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE=1800
LOG_LEVEL=INFO
