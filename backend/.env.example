# Local development. Production values belong in Coolify.
ENVIRONMENT=development
APP_URL=http://localhost:5173
DATABASE_URL=mysql+asyncmy://syllo:change-me@127.0.0.1:3306/syllo?charset=utf8mb4
JWT_SECRET=replace-with-at-least-32-random-characters
OAUTH_STATE_SECRET=replace-with-another-32-random-characters
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
MOBILE_OAUTH_REDIRECT_URI=syllo://google-callback

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SCHOLAR=
STRIPE_PRICE_DEANS_LIST=

ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional; no outbound study-companion provider is enabled by default.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE=1800
LOG_LEVEL=INFO
